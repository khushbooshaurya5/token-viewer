{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Back end: uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["token_viewer.api:app", "--port", "8000"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "",
            "preLaunchTask": "uv: sync",
            "justMyCode": true
        }
    ]
}
